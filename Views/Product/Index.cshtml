
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>10 Min Grocery</title>

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/scrollbar.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
</head>

<body>

  <nav class="navbar navbar-expand-lg bg-white sticky-top border-bottom">
    <div class="container py-2">
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="#">
        <span class="brand-icon"><i class="bi bi-leaf-fill"></i></span>
        <span>10 Min <span class="brand-green">Grocery</span></span>
      </a>

      <div class="search-box mx-lg-5 flex-grow-1 order-3 order-lg-2 mt-3 mt-lg-0">
        <i class="bi bi-search"></i>
        <input id="searchInput" type="search" placeholder="Search for products...">
      </div>

      <div class="d-flex align-items-center gap-2 order-2 order-lg-3">
        <a href="cart.html" class="icon-btn position-relative" title="Cart">
          <i class="bi bi-cart3"></i>
          <span id="cartCount" class="cart-badge">0</span>
        </a>
        <button class="icon-btn theme-toggle" id="themeToggle" type="button" title="Toggle dark mode">
          <i class="bi bi-moon-stars"></i>
        </button>
        <a href="profile.html" class="icon-btn profile-link" title="Profile">
          <i class="bi bi-person"></i>
        </a>
      </div>
    </div>
  </nav>

  <main class="container py-4">

    <!-- Hero -->
    <section class="hero mb-4">
      <div class="hero-content">
        <div class="hero-copy">
          <div class="eyebrow">FRESH <span>•</span> FAST <span>•</span> LOCAL</div>
          <h1>Groceries in<br><strong>10 Minutes</strong></h1>
          <p>Fresh products, everyday essentials,<br class="d-none d-sm-block">
            delivered right to your door.</p>
          <button class="btn-shop"
            onclick="document.getElementById('products').scrollIntoView({behavior:'smooth'})">
            Shop Now <i class="bi bi-arrow-right"></i>
          </button>
        </div>
        <div class="hero-visual">
          <div class="delivery-badge">
            <i class="bi bi-lightning-charge-fill"></i>
            <strong>10 Min</strong>
            <small>Delivery</small>
          </div>
          <div class="produce">🥬 🥕 🍅 🫑 🍌</div>
          <div class="bag">🛍️</div>
        </div>
      </div>
    </section>

    <!-- Categories -->
    <section class="mb-4">
      <div class="section-heading">
        <h2>Shop by Category</h2>
        <button id="categoriesToggle" class="view-all" onclick="showAllCategories()">
          <span>View All</span> <i class="bi bi-grid"></i>
        </button>
      </div>

      <div id="categories" class="category-scroller">
        <button class="category-card active" data-category="all">
          <span class="category-image">🥦</span>
          <span>All</span>
        </button>
        <button class="category-card" data-category="Fruits & Vegetables">
          <span class="category-image">🥕</span>
          <span>Fruits &<br>Vegetables</span>
        </button>
        <button class="category-card" data-category="Dairy & Eggs">
          <span class="category-image">🥛</span>
          <span>Dairy &<br>Eggs</span>
        </button>
        <button class="category-card" data-category="Snacks & Beverages">
          <span class="category-image">🍿</span>
          <span>Snacks &<br>Beverages</span>
        </button>
        <button class="category-card" data-category="Bakery">
          <span class="category-image">🥖</span>
          <span>Bakery</span>
        </button>
        <button class="category-card" data-category="Pantry">
          <span class="category-image">🌾</span>
          <span>Pantry</span>
        </button>
        <button class="category-card" data-category="Household">
          <span class="category-image">🧴</span>
          <span>Household</span>
        </button>
        <button class="category-card" data-category="Personal Care">
          <span class="category-image">🧼</span>
          <span>Personal<br>Care</span>
        </button>
      </div>
    </section>

    <!-- Deal Highlights -->
    <section class="deal-strip mb-4">
      <div class="deal-strip-heading">
        <div>
          <span class="deal-kicker"><i class="bi bi-fire"></i> DEAL HIGHLIGHTS</span>
          <h2>Hot deals near you</h2>
        </div>
        <span class="deal-timer"><i class="bi bi-lightning-charge-fill"></i> Limited time</span>
      </div>
      <div class="deal-items">
        <div class="deal-mini-card">
          <span class="deal-mini-icon">🥑</span>
          <div><strong>Fresh Picks</strong><small>Up to 30% off</small></div>
        </div>
        <div class="deal-mini-card">
          <span class="deal-mini-icon">🥛</span>
          <div><strong>Daily Essentials</strong><small>Save on combos</small></div>
        </div>
        <div class="deal-mini-card">
          <span class="deal-mini-icon">🍎</span>
          <div><strong>Fruit Fiesta</strong><small>20% off selected</small></div>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section id="products">
      <div class="section-heading">
        <h2>Popular Items <span id="resultCount" class="result-count"></span></h2>
        <a href="all-products.html" class="view-all">Show all <i class="bi bi-arrow-right"></i></a>
      </div>

      <div id="productGrid" class="row g-3"></div>

      <div id="noResults" class="text-center py-5 d-none">
        <div class="empty-icon">🛒</div>
        <h5>No products found</h5>
        <p class="text-muted">Try another product or category.</p>
      </div>
    </section>
  </main>

  <!-- ============ Product Modal (bottom sheet on phones, split card on desktop) ============ -->
  <div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="modalName" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered sheet-dialog">
      <div class="modal-content product-modal">

        <span class="pm-grip"></span>

        <button type="button" class="modal-close" data-bs-dismiss="modal" aria-label="Close">
          <i class="bi bi-x-lg"></i>
        </button>

        <div class="pm-body">

          <!-- Left: image gallery -->
          <div class="pm-gallery">
            <div class="pm-main" id="modalMain">
              <button type="button" class="pm-nav prev" aria-label="Previous image" onclick="stepImage(-1)">
                <i class="bi bi-chevron-left"></i>
              </button>
              <div class="pm-track" id="modalTrack"></div>
              <button type="button" class="pm-nav next" aria-label="Next image" onclick="stepImage(1)">
                <i class="bi bi-chevron-right"></i>
              </button>

              <div class="pm-badges">
                <span id="modalOffer" class="pm-offer"></span>
                <span id="modalHot" class="pm-hot"></span>
              </div>

              <button type="button" id="modalFav" class="pm-fav" aria-label="Save to favourites">
                <i class="bi bi-heart"></i>
              </button>
            </div>

            <div id="modalDots" class="pm-dots"></div>

            <div id="modalThumbs" class="pm-thumbs"></div>

            <div class="pm-trust">
              <div class="pm-trust-track">
                <span class="pm-trust-item"><i class="bi bi-patch-check-fill"></i> Quality checked</span>
                <span class="pm-trust-item"><i class="bi bi-snow2"></i> Freshly packed</span>
                <span class="pm-trust-item"><i class="bi bi-truck"></i> Fast delivery</span>
                <span class="pm-trust-item"><i class="bi bi-arrow-repeat"></i> Easy returns</span>
                <span class="pm-trust-item" aria-hidden="true"><i class="bi bi-patch-check-fill"></i> Quality checked</span>
                <span class="pm-trust-item" aria-hidden="true"><i class="bi bi-snow2"></i> Freshly packed</span>
                <span class="pm-trust-item" aria-hidden="true"><i class="bi bi-truck"></i> Fast delivery</span>
                <span class="pm-trust-item" aria-hidden="true"><i class="bi bi-arrow-repeat"></i> Easy returns</span>
              </div>
            </div>
          </div>

          <!-- Right: details -->
          <div class="pm-info">
            <span id="modalCategory" class="modal-category"></span>
            <h2 id="modalName" class="pm-title"></h2>
            <p id="modalUnit" class="pm-unit"></p>

            <div class="pm-netqty">
              <i class="bi bi-box-seam"></i> Net Quantity: <b id="modalNetQty"></b>
            </div>

            <div class="rating">
              <span class="stars">★★★★★<span class="stars-fill" id="modalStars">★★★★★</span></span>
              <strong id="modalRating"></strong>
              <small id="modalReviews"></small>
            </div>

            <div class="pm-price-row">
              <div class="modal-price" id="modalPrice"></div>
              <span id="modalSave" class="pm-save"></span>
            </div>

            <p id="modalDescription" class="modal-description"></p>

            <div class="pm-hl-wrap">
              <div class="pm-hl-title"><i class="bi bi-stars"></i> Highlights</div>
              <div id="modalHighlights"></div>
            </div>
          </div>
        </div>

        <!-- Sticky action bar -->
        <div class="pm-action">
          <div class="quantity-control">
            <button type="button" onclick="changeQuantity(-1)" aria-label="Decrease quantity">−</button>
            <span id="quantity">1</span>
            <button type="button" onclick="changeQuantity(1)" aria-label="Increase quantity">+</button>
          </div>
          <button id="modalAddButton" type="button" class="btn-add-modal" onclick="addFromModal()">
            <span>Add to cart</span>
            <b id="modalTotal">$0.00</b>
          </button>
        </div>

      </div>
    </div>
  </div>

  <div id="toast" class="toast-message">
    <i class="bi bi-check-circle-fill"></i>
    <span>Added to cart</span>
  </div>

  <footer class="border-top mt-5">
    <div class="container py-4 text-center text-muted small">
      © 2026 10 Min Grocery · Fresh groceries, delivered fast.
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="script.js"></script>
</body>


