</nav>

<main class="container py-4">
  <div class="page-wrap">

    <a href="cart.html" class="back-link"><i class="bi bi-arrow-left"></i> Back to cart</a>

    <div class="page-head">
      <h1>Coupons &amp; Offers</h1>
      <span class="count-chip" id="couponCountLabel">6 available</span>
    </div>
    <p class="page-sub">Tap <strong>Apply Coupon</strong> to browse every offer and pick the best one for your order.</p>

    <!-- ============ Applied / empty coupon wallet ============ -->
    <section class="wallet is-empty" id="wallet" aria-live="polite">

      <div id="walletEmpty">
        <div class="wallet-illus">🎟️</div>
        <h3 class="wallet-h">No coupon applied yet</h3>
        <p class="wallet-p"><strong id="availCount">6</strong> offers waiting · save up to <strong id="maxSave">₹0</strong> on this order</p>
        <button type="button" class="btn-open-coupons" id="openCouponBtn">
          <i class="bi bi-ticket-perforated-fill"></i> Apply Coupon
        </button>
      </div>

      <div id="walletApplied" class="d-none">
        <div class="applied-ticket" id="appliedTicket">
          <div class="ticket-stub">
            <span class="stub-emoji" id="stubEmoji">🎉</span>
            <span class="saved-label">You saved</span>
            <span class="saved-amount" id="stubAmount">₹0</span>
          </div>
          <div class="ticket-body">
            <div class="ticket-row">
              <span class="ticket-code" id="ticketCode">CODE</span>
              <button type="button" class="ticket-copy" id="ticketCopy" title="Copy code" aria-label="Copy coupon code"><i class="bi bi-copy"></i></button>
              <button type="button" class="ticket-remove" id="ticketRemove" title="Remove coupon" aria-label="Remove coupon"><i class="bi bi-x-lg"></i></button>
            </div>
            <p class="ticket-title" id="ticketTitle">Coupon title</p>
            <p class="ticket-note" id="ticketNote">Discount applied</p>
            <div class="ticket-foot">
              <span class="applied-pill"><i class="bi bi-check-circle-fill"></i> Applied</span>
              <button type="button" class="btn-change" id="changeCouponBtn"><i class="bi bi-arrow-repeat"></i> Change</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Delivery detail ============ -->
    <h2 class="section-title"><i class="bi bi-geo-alt"></i> Delivering to</h2>

    <div class="d-row">
      <div class="d-icon"><i class="bi bi-person"></i></div>
      <div class="d-main">
        <span class="d-label">Deliver to</span>
        <div class="field-display" id="nameDisplay">Aarav Mehta</div>
      </div>
    </div>

    <div class="d-row">
      <div class="d-icon"><i class="bi bi-geo-alt"></i></div>
      <div class="d-main">
        <span class="d-label">Address</span>
        <div class="field-display" id="addressDisplay"></div>
        <textarea class="field-input d-none" id="addressInput" rows="2"></textarea>
      </div>
      <button type="button" class="edit-pencil" id="addressBtn" onclick="toggleEdit('address')" aria-label="Edit address"><i class="bi bi-pencil"></i></button>
