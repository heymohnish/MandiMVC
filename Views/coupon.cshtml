<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Coupons & Offers - 10 Min Grocery</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap');

  * { box-sizing: border-box; }

  :root {
    --ink: #16241D; --muted: #6B7A70; --bg: #FCFBF7; --surface: #FFFFFF; --soft: #F3F6EF;
    --forest: #123524; --forest-2: #1B4332; --lime: #C6F135; --lime-ink: #294011;
    --coral: #FF6B4A; --on-coral: #FFFFFF; --line: #E7E5DC; --brand: #123524;
    --tile: linear-gradient(155deg, #EAF3EC, #DCEBDF);
    --shadow: 0 16px 32px -18px rgba(18, 53, 36, .55);
    --shadow-lg: 0 26px 50px -24px rgba(18, 53, 36, .6);
  }
  body.dark-mode {
    --ink: #EDEDE7; --muted: #93A398; --bg: #0F1712; --surface: #182019; --soft: #1E2A22;
    --forest: #2F6B4E; --forest-2: #3A7D5C; --lime-ink: #182B10;
    --coral: #FF8768; --on-coral: #2B0F08; --line: #263029; --brand: #C6F135;
    --tile: linear-gradient(155deg, #1F3327, #16241D);
    --shadow: 0 16px 32px -18px rgba(0, 0, 0, .85);
    --shadow-lg: 0 26px 50px -24px rgba(0, 0, 0, .9);
    color-scheme: dark;
  }

  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
    transition: background .2s ease, color .2s ease;
    padding-bottom: 24px;
    overscroll-behavior-y: none; /* prevent rubber-band chaining */
  }

  /* ===== FIX 2: body scroll lock (desktop + iOS) ===== */
  body.modal-open {
    overflow: hidden;
    overscroll-behavior-y: none;
  }
  /* iOS Safari ignores overflow:hidden on body — use fixed positioning there */
  body.is-ios.modal-open {
    position: fixed;
    width: 100%;
    left: 0;
    right: 0;
  }

  h1, h2, h3, h5, .navbar-brand { font-family: 'Fredoka', system-ui, sans-serif; }
  a { text-decoration: none; }
  button { font-family: inherit; }

  @keyframes bump { 45% { transform: scale(1.35); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes floaty { 50% { transform: translateY(-6px); } }
  @keyframes shake { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }
  @keyframes ticketPop { 0% { transform: scale(.94); opacity: .35; } 60% { transform: scale(1.015); } 100% { transform: scale(1); opacity: 1; } }
  @keyframes pulseRing {
    0% { box-shadow: 0 0 0 0 rgba(198, 241, 53, .55); }
    70% { box-shadow: 0 0 0 14px rgba(198, 241, 53, 0); }
    100% { box-shadow: 0 0 0 0 rgba(198, 241, 53, 0); }
  }
  @keyframes confettiPop {
    0% { transform: translate(-50%, -50%) rotate(0deg) scale(1); opacity: 1; }
    100% { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) rotate(var(--rot)) scale(.35); opacity: 0; }
  }
  @keyframes flashUpdate { 0% { background: rgba(198, 241, 53, .5); } 100% { background: transparent; } }

  /* ---------- Navbar ---------- */
  .navbar { background: var(--surface) !important; border-bottom: 1px solid var(--line); }
  .navbar-brand { color: var(--ink); font-size: 1.2rem; font-weight: 600; }
  .navbar-brand:hover { color: var(--ink); }
  .brand-icon {
    width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: 12px; background: var(--lime); color: #123524; transform: rotate(-8deg);
  }
  .brand-green { position: relative; z-index: 0; color: var(--ink); }
  .brand-green::after {
    content: ''; position: absolute; left: -3px; right: -3px; bottom: 3px;
    height: 9px; background: var(--lime); opacity: .75; z-index: -1; border-radius: 4px;
  }
  body.dark-mode .brand-green { color: var(--lime); }
  body.dark-mode .brand-green::after { display: none; }

  .nav-icon {
    position: relative; width: 40px; height: 40px; display: grid; place-items: center;
    border: 1.5px solid var(--line); border-radius: 50%;
    background: var(--surface); color: var(--ink); font-size: 1.05rem; transition: background .15s;
  }
  .nav-icon:hover { background: var(--soft); color: var(--ink); }
  .nav-badge {
    position: absolute; top: -5px; right: -5px; min-width: 18px; height: 18px; padding: 0 4px;
    display: grid; place-items: center; border-radius: 999px;
    background: var(--coral); color: var(--on-coral); font-size: .65rem; font-weight: 800;
  }

  /* ---------- Page ---------- */
  .page-wrap { max-width: 920px; margin: auto; animation: fadeUp .4s ease both; }
  .back-link {
    display: inline-flex; align-items: center; gap: 8px; margin-bottom: 14px;
    color: var(--muted); font-size: .85rem; font-weight: 600;
  }
  .back-link:hover { color: var(--brand); }

  .page-head { display: flex; align-items: center; gap: 12px; margin-bottom: 4px; flex-wrap: wrap; }
  .page-head h1 { margin: 0; font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; }
  .count-chip {
    padding: 4px 12px; border-radius: 999px; background: rgba(198, 241, 53, .4); color: #123524;
    font-size: .76rem; font-weight: 700;
  }
  body.dark-mode .count-chip { background: rgba(198, 241, 53, .14); color: var(--lime); }
  .page-sub { margin: 0 0 20px; color: var(--muted); font-size: .9rem; }

  .section-title { display: flex; align-items: center; gap: 8px; margin: 26px 0 12px; font-size: 1.05rem; font-weight: 600; }
  .section-title i { color: var(--brand); }

  /* ---------- Delivery detail ---------- */
  .d-row {
    display: flex; align-items: flex-start; gap: 14px; margin-bottom: 10px; padding: 14px;
    border: 1px solid var(--line); border-radius: 18px; background: var(--surface);
  }
  .d-icon { flex: 0 0 40px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 12px; background: var(--tile); color: var(--brand); font-size: 1.05rem; }
  .d-main { flex: 1; min-width: 0; }
  .d-label { display: block; margin-bottom: 2px; color: var(--muted); font-size: .72rem; font-weight: 600; }
  .field-display { font-size: .92rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .field-input {
    width: 100%; padding: 8px 10px; border: 1.5px solid var(--forest); border-radius: 12px;
    background: var(--bg); color: var(--ink); font-family: 'Inter'; font-size: .92rem; resize: none;
  }
  .field-input:focus { outline: none; box-shadow: 0 0 0 3px rgba(198, 241, 53, .35); }
  .edit-pencil {
    flex: 0 0 34px; width: 34px; height: 34px; display: grid; place-items: center;
    border: 1.5px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); font-size: .85rem;
    transition: background .15s, color .15s, border-color .15s;
  }
  .edit-pencil:hover { background: var(--soft); }
  .edit-pencil.editing { background: var(--lime); border-color: var(--lime); color: var(--lime-ink); }

  /* ================= WALLET / APPLIED COUPON HERO ================= */
  .wallet {
    position: relative;
    border: 1.5px solid var(--line);
    border-radius: 26px;
    background: var(--surface);
    padding: 22px;
    transition: border-color .25s, background .25s, box-shadow .25s;
  }
  .wallet.is-empty {
    border-style: dashed;
    text-align: center;
    padding: 30px 22px 28px;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(198, 241, 53, .14), transparent 62%),
      var(--surface);
  }
  .wallet-illus {
    width: 74px; height: 74px; margin: 0 auto 14px;
    display: grid; place-items: center; font-size: 2.1rem;
    border-radius: 24px; background: var(--tile);
    animation: floaty 3.4s ease-in-out infinite;
  }
  .wallet-h { margin: 0 0 6px; font-size: 1.2rem; font-weight: 600; }
  .wallet-p { margin: 0 0 4px; color: var(--muted); font-size: .86rem; }
  .wallet-p strong { color: var(--brand); }

  .btn-open-coupons {
    display: inline-flex; align-items: center; gap: 9px;
    margin-top: 18px; padding: 14px 28px;
    border: 0; border-radius: 999px;
    background: var(--forest); color: #fff;
    font-size: .93rem; font-weight: 800; letter-spacing: .01em;
    box-shadow: 0 14px 26px -14px rgba(18, 53, 36, .85);
    transition: transform .15s, background .15s;
    animation: pulseRing 2.6s ease-out infinite;
  }
  .btn-open-coupons:hover { background: var(--forest-2); transform: translateY(-2px); color: #fff; }
  .btn-open-coupons:active { transform: scale(.97); }

  .applied-ticket {
    position: relative;
    display: flex; align-items: stretch;
    border-radius: 22px; overflow: hidden;
    background: linear-gradient(135deg, var(--forest), var(--forest-2));
    color: #fff;
    box-shadow: var(--shadow-lg);
  }
  .applied-ticket.pop { animation: ticketPop .45s cubic-bezier(.34, 1.56, .64, 1) both; }

  .ticket-stub {
    position: relative;
    flex: 0 0 120px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 3px; padding: 18px 10px;
    background: linear-gradient(160deg, #DAFA66, #B5E71C);
    color: #294011;
  }
  .ticket-stub::after {
    content: ''; position: absolute; right: 0; top: 14px; bottom: 14px;
    border-right: 2px dashed rgba(41, 64, 17, .3);
  }
  .stub-emoji { font-size: 1.35rem; line-height: 1; }
  .saved-label { font-size: .6rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; opacity: .75; }
  .saved-amount { font-family: 'Fredoka'; font-size: 1.75rem; font-weight: 700; line-height: 1; }

  .ticket-body { flex: 1; min-width: 0; padding: 16px 18px; display: flex; flex-direction: column; gap: 7px; }
  .ticket-row { display: flex; align-items: center; gap: 8px; }
  .ticket-code {
    font-family: 'Fredoka'; font-size: .84rem; font-weight: 600; letter-spacing: .07em;
    padding: 4px 11px; border-radius: 999px;
    background: rgba(255, 255, 255, .14);
    border: 1px dashed rgba(255, 255, 255, .5);
  }
  .ticket-copy, .ticket-remove {
    width: 28px; height: 28px; display: grid; place-items: center;
    border: 0; border-radius: 50%;
    background: rgba(255, 255, 255, .12); color: #fff; font-size: .78rem;
    transition: background .15s, color .15s;
  }
  .ticket-copy:hover { background: rgba(255, 255, 255, .28); }
  .ticket-remove { margin-left: auto; }
  .ticket-remove:hover { background: var(--coral); }
  .ticket-title { margin: 0; font-size: .88rem; font-weight: 600; color: rgba(255, 255, 255, .93); }
  .ticket-note { margin: 0; font-size: .74rem; color: rgba(255, 255, 255, .62); }
  .ticket-foot { display: flex; align-items: center; gap: 10px; margin-top: 4px; }
  .applied-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 11px; border-radius: 999px;
    background: rgba(198, 241, 53, .2); color: #E2FF8C;
    font-size: .68rem; font-weight: 800; letter-spacing: .04em;
  }
  .btn-change {
    margin-left: auto;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 15px; border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, .35);
    background: transparent; color: #fff;
    font-size: .76rem; font-weight: 700;
    transition: background .15s, border-color .15s;
  }
  .btn-change:hover { background: rgba(255, 255, 255, .14); border-color: rgba(255, 255, 255, .65); }

  .confetti-piece {
    position: absolute; top: 50%; left: 50%; width: 6px; height: 10px; border-radius: 2px;
    pointer-events: none; animation: confettiPop .95s ease-out forwards; z-index: 6;
  }

  /* ================= MODAL / BOTTOM SHEET ================= */
  .sheet-backdrop {
    position: fixed; inset: 0; z-index: 1040;
    background: rgba(9, 20, 14, .55);
    opacity: 0; visibility: hidden;
    /* ===== FIX 3: backdrop-filter removed from hidden state ===== */
    transition: opacity .28s ease, visibility .28s ease;
  }
  .sheet-backdrop.show {
    opacity: 1; visibility: visible;
    /* Blur only applied while visible — avoids constant repaints */
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }

  .sheet {
    position: fixed; z-index: 1050;
    left: 50%; bottom: 0;
    width: min(620px, 100%);
    max-height: 90dvh;
    display: flex; flex-direction: column;
    background: var(--surface); color: var(--ink);
    border-radius: 28px 28px 0 0;
    box-shadow: 0 -24px 60px -20px rgba(0, 0, 0, .5);
    transform: translate(-50%, 102%);
    /* ===== FIX 4: hide completely + delay visibility so slide-out animates ===== */
    visibility: hidden;
    pointer-events: none;
    will-change: transform;
    transition: transform .38s cubic-bezier(.22, 1, .36, 1), visibility 0s linear .38s;
    overflow: hidden;
  }
  .sheet.show {
    transform: translate(-50%, 0);
    visibility: visible;
    pointer-events: auto;
    transition: transform .38s cubic-bezier(.22, 1, .36, 1), visibility 0s;
  }

  @media (min-width: 576px) {
    .sheet {
      top: 50%; bottom: auto;
      max-height: min(740px, 86vh);
      border-radius: 28px;
      opacity: 0;
      transform: translate(-50%, -44%) scale(.97);
      transition: transform .32s cubic-bezier(.22, 1, .36, 1), opacity .26s ease, visibility 0s linear .32s;
    }
    .sheet.show {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
      transition: transform .32s cubic-bezier(.22, 1, .36, 1), opacity .26s ease, visibility 0s;
    }
  }

  .sheet-handle { display: none; }
  @media (max-width: 575.98px) {
    .sheet-handle { display: block; width: 44px; height: 5px; border-radius: 999px; background: var(--line); margin: 10px auto 0; }
  }

  .sheet-head { display: flex; align-items: flex-start; gap: 12px; padding: 18px 20px 10px; }
  .sheet-head h3 { margin: 0; font-size: 1.18rem; font-weight: 600; }
  .sheet-head p { margin: 3px 0 0; font-size: .78rem; color: var(--muted); }
  .sheet-close {
    margin-left: auto; flex: 0 0 34px;
    width: 34px; height: 34px; display: grid; place-items: center;
    border: 1.5px solid var(--line); border-radius: 50%;
    background: transparent; color: var(--ink); font-size: .85rem;
    transition: background .15s, transform .15s;
  }
  .sheet-close:hover { background: var(--soft); transform: rotate(90deg); }

  .coupon-search { position: relative; margin: 6px 20px 12px; }
  .coupon-search i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .coupon-search input {
    width: 100%; height: 46px; padding: 0 16px 0 44px;
    border: 1.5px solid var(--line); border-radius: 999px;
    background: var(--bg); color: var(--ink); font-size: .9rem; outline: none;
    transition: border-color .2s, box-shadow .2s;
  }
  .coupon-search input::placeholder { color: var(--muted); }
  .coupon-search input:focus { border-color: var(--forest); box-shadow: 0 0 0 3px rgba(198, 241, 53, .35); }

  .sheet-body {
    flex: 1; min-height: 0;
    overflow-y: auto; overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 4px 20px 18px;
    display: flex; flex-direction: column; gap: 12px;
  }

  /* --- coupon row inside modal --- */
  .coupon-item {
    position: relative;
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    border: 1.5px solid var(--line); border-radius: 18px;
    background: var(--surface);
    cursor: pointer;
    transition: border-color .18s, background .18s, transform .15s, box-shadow .18s;
  }
  .coupon-item:hover { border-color: var(--muted); transform: translateY(-1px); }
  .coupon-item:focus-visible { outline: 3px solid rgba(198, 241, 53, .6); outline-offset: 2px; }
  .coupon-item.selected {
    border-color: var(--forest);
    background: linear-gradient(180deg, rgba(198, 241, 53, .13), rgba(198, 241, 53, .03));
    box-shadow: 0 12px 26px -18px rgba(18, 53, 36, .8);
  }
  body.dark-mode .coupon-item.selected { border-color: var(--lime); }
  .coupon-item.locked { opacity: .5; cursor: not-allowed; }
  .coupon-item.locked:hover { transform: none; border-color: var(--line); }
  .coupon-item.shake { animation: shake .4s ease; }

  .ci-check {
    flex: 0 0 22px; width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid var(--line);
    display: grid; place-items: center;
    color: transparent; font-size: .68rem;
    transition: background .18s, border-color .18s, color .18s, transform .18s;
  }
  .coupon-item.selected .ci-check { background: var(--forest); border-color: var(--forest); color: #fff; transform: scale(1.08); }
  body.dark-mode .coupon-item.selected .ci-check { background: var(--lime); border-color: var(--lime); color: var(--lime-ink); }

  .ci-emoji {
    flex: 0 0 44px; width: 44px; height: 44px; border-radius: 14px;
    display: grid; place-items: center; font-size: 1.25rem;
    background: var(--tile);
  }

  .ci-body { flex: 1; min-width: 0; }
  .ci-code {
    display: inline-flex; align-items: center; gap: 5px;
    font-family: 'Fredoka'; font-size: .82rem; font-weight: 600; letter-spacing: .06em;
    color: var(--brand);
  }
  .ci-copy {
    border: 0; background: transparent; padding: 2px 3px;
    color: var(--muted); font-size: .72rem; line-height: 1;
    transition: color .15s, transform .15s;
  }
  .ci-copy:hover { color: var(--coral); transform: scale(1.15); }
  .ci-badge {
    display: inline-block; margin-left: 6px; padding: 2px 7px; border-radius: 999px;
    font-size: .56rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    background: var(--coral); color: var(--on-coral);
    vertical-align: middle;
  }
  .ci-badge.best { background: var(--lime); color: #294011; }
  .ci-title { display: block; margin: 3px 0 5px; font-size: .8rem; color: var(--ink); }
  .ci-meta { display: flex; flex-wrap: wrap; gap: 10px; font-size: .68rem; font-weight: 600; color: var(--muted); }
  .ci-meta i { color: var(--brand); }
  .ci-warn { color: var(--coral); font-weight: 800; }

  .ci-right { flex: 0 0 auto; text-align: right; display: flex; flex-direction: column; gap: 1px; }
  .ci-disc { font-family: 'Fredoka'; font-size: 1.08rem; font-weight: 700; color: var(--brand); line-height: 1.1; }
  .ci-off { font-size: .58rem; font-weight: 800; letter-spacing: .09em; color: var(--muted); }

  .no-coupons { display: none; text-align: center; padding: 36px 20px; color: var(--muted); }
  .no-coupons.show { display: block; }
  .no-coupons .emoji { font-size: 2.2rem; margin-bottom: 8px; }
  .no-coupons h5 { font-size: 1rem; margin-bottom: 4px; color: var(--ink); }
  .no-coupons p { margin: 0; font-size: .82rem; }

  .sheet-foot {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 20px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .foot-info { display: flex; flex-direction: column; min-width: 0; }
  .foot-info .lbl { font-size: .72rem; font-weight: 600; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .foot-info .val { font-family: 'Fredoka'; font-size: 1.05rem; font-weight: 600; color: var(--brand); }
  .btn-apply-selected {
    margin-left: auto; flex: 0 0 auto;
    min-width: 132px; height: 48px; padding: 0 24px;
    border: 0; border-radius: 999px;
    background: var(--forest); color: #fff;
    font-size: .9rem; font-weight: 800;
    transition: transform .12s, background .15s, opacity .2s;
  }
  .btn-apply-selected:disabled { opacity: .35; cursor: not-allowed; }
  .btn-apply-selected:not(:disabled):hover { background: var(--forest-2); color: #fff; }
  .btn-apply-selected:not(:disabled):active { transform: scale(.97); }

  /* ---------- Order summary ---------- */
  .bill-card { padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 26px; margin-top: 8px; }
  .bill-card h2 { margin: 0 0 14px; font-size: 1.15rem; font-weight: 600; }

  .saved-banner {
    display: none; align-items: center; gap: 9px;
    margin: 0 0 16px; padding: 11px 15px; border-radius: 14px;
    background: linear-gradient(100deg, rgba(198, 241, 53, .3), rgba(198, 241, 53, .07));
    color: var(--forest); font-size: .8rem; font-weight: 700;
    animation: fadeUp .3s ease both;
  }
  body.dark-mode .saved-banner { color: var(--lime); }
  .saved-banner.show { display: flex; }
  .saved-banner i { font-size: 1rem; }

  .bill-coupon-cta {
    display: flex; align-items: center; gap: 10px; width: 100%;
    margin-bottom: 18px; padding: 13px 16px;
    border: 1.5px dashed var(--line); border-radius: 16px;
    background: transparent; color: var(--ink);
    font-size: .85rem; font-weight: 700; text-align: left;
    transition: border-color .18s, background .18s;
  }
  .bill-coupon-cta:hover { border-color: var(--forest); background: var(--soft); }
  .bill-coupon-cta .lead-icon { color: var(--brand); font-size: 1rem; }
  .bill-coupon-cta .chev { margin-left: auto; color: var(--muted); }

  .bill-row { display: flex; justify-content: space-between; margin-bottom: 9px; color: var(--muted); font-size: .88rem; border-radius: 8px; transition: background .2s; }
  .bill-row.flash { animation: flashUpdate .9s ease; }
  .bill-row.coupon-row { color: var(--forest); font-weight: 700; align-items: center; }
  body.dark-mode .bill-row.coupon-row { color: var(--lime); }
  .remove-coupon {
    margin-left: 8px; padding: 2px 9px;
    border: 0; border-radius: 999px;
    background: rgba(255, 107, 74, .16); color: var(--coral);
    font-size: .67rem; font-weight: 800; cursor: pointer;
    transition: background .15s;
  }
  .remove-coupon:hover { background: rgba(255, 107, 74, .3); }
  .bill-row.total {
    margin: 14px 0 0; padding-top: 14px; border-top: 1px dashed var(--line);
    color: var(--ink); font-size: 1.05rem; font-weight: 800;
  }
  .bill-row.total span:last-child { font-family: 'Fredoka'; font-size: 1.3rem; color: var(--brand); }

  .btn-place-order {
    display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 52px; margin-top: 16px;
    border: 0; border-radius: 999px; background: var(--forest); color: #fff; font-size: .95rem; font-weight: 700;
    transition: background .15s, transform .12s;
  }
  .btn-place-order:hover { background: var(--forest-2); color: #fff; transform: translateY(-2px); }
  .bill-note { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 12px 0 0; color: var(--muted); font-size: .76rem; }
  .bill-note i { color: var(--brand); }

  /* ---------- Toast ---------- */
  .toast-message {
    position: fixed; left: 50%; z-index: 2000;
    bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    max-width: calc(100vw - 32px);
    display: flex; align-items: center; gap: 9px;
    padding: 12px 20px; border-radius: 999px;
    background: var(--lime); color: #294011;
    font-size: .85rem; font-weight: 700;
    box-shadow: 0 16px 28px -12px rgba(0, 0, 0, .5);
    opacity: 0; pointer-events: none; transform: translate(-50%, 30px);
    transition: opacity .25s, transform .25s;
  }
  .toast-message.show { opacity: 1; transform: translate(-50%, 0); }
  .toast-message.error { background: var(--coral); color: var(--on-coral); }

  /* ---------- Responsive ---------- */
  @media (max-width: 575.98px) {
    .navbar-brand { font-size: 1rem; }
    .applied-ticket { flex-direction: column; }
    .ticket-stub {
      flex: 0 0 auto; flex-direction: row; gap: 10px;
      padding: 12px 16px; justify-content: center;
    }
    .ticket-stub::after {
      right: 16px; left: 16px; top: auto; bottom: 0;
      border-right: 0; border-bottom: 2px dashed rgba(41, 64, 17, .28);
    }
    .saved-amount { font-size: 1.35rem; }
    .saved-label { order: -1; }
    .ci-emoji { flex-basis: 38px; width: 38px; height: 38px; font-size: 1.05rem; border-radius: 12px; }
    .ci-disc { font-size: .98rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
<link rel="stylesheet" href="scrollbar.css">
</head>
<body>

<!-- Navbar -->
<nav class="navbar sticky-top">
  <div class="container py-2">
    <div class="d-flex align-items-center w-100">
      <a href="index.html" class="navbar-brand fw-bold d-flex align-items-center gap-2">
        <span class="brand-icon"><i class="bi bi-leaf-fill"></i></span>
        <span>10 Min <span class="brand-green">Grocery</span></span>
      </a>
      <div class="ms-auto d-flex gap-2">
        <a href="cart.html" class="nav-icon" title="Cart">
          <i class="bi bi-cart3"></i>
          <span class="nav-badge" id="navCartCount">0</span>
        </a>
        <button class="nav-icon" id="themeToggle" type="button" title="Toggle dark mode"><i class="bi bi-moon-stars"></i></button>
