<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Your Cart - 10 Min Grocery</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap');

  * { box-sizing: border-box; }

  /* ---------- Tokens (shared across the whole app) ---------- */
  :root {
    --ink: #16241D; --muted: #6B7A70; --bg: #FCFBF7; --surface: #FFFFFF; --soft: #F3F6EF;
    --forest: #123524; --forest-2: #1B4332; --lime: #C6F135; --lime-ink: #294011;
    --coral: #FF6B4A; --on-coral: #FFFFFF; --line: #E7E5DC; --brand: #123524;
    --tile: linear-gradient(155deg, #EAF3EC, #DCEBDF);
    --hero-a: #123524; --hero-b: #1F5A3F;
    --shadow: 0 16px 32px -18px rgba(18, 53, 36, .55);
  }
  body.dark-mode {
    --ink: #EDEDE7; --muted: #93A398; --bg: #0F1712; --surface: #182019; --soft: #1E2A22;
    --forest: #2F6B4E; --forest-2: #3A7D5C; --lime-ink: #182B10;
    --coral: #FF8768; --on-coral: #2B0F08; --line: #263029; --brand: #C6F135;
    --tile: linear-gradient(155deg, #1F3327, #16241D);
    --hero-a: #16382A; --hero-b: #24563E;
    --shadow: 0 16px 32px -18px rgba(0, 0, 0, .85);
    color-scheme: dark;
  }

  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: 'Inter', system-ui, -apple-system, "Segoe UI", sans-serif;
    transition: background .2s ease, color .2s ease;
  }
  h1, h2, h3, h5, .navbar-brand { font-family: 'Fredoka', system-ui, sans-serif; }
  a { text-decoration: none; }

  @keyframes bump { 45% { transform: scale(1.35); } }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes floaty { 50% { transform: translateY(-6px); } }
  @keyframes circleDraw { to { stroke-dashoffset: 0; } }
  @keyframes checkDraw { to { stroke-dashoffset: 0; } }

  /* ---------- Navbar ---------- */
  .navbar { background: var(--surface) !important; border-bottom: 1px solid var(--line); }
  .navbar-brand { color: var(--ink); font-size: 1.2rem; font-weight: 600; }
  .navbar-brand:hover { color: var(--ink); }
  .brand-icon {
    width: 36px; height: 36px; display: grid; place-items: center;
    border-radius: 12px; background: var(--lime); color: var(--forest); transform: rotate(-8deg);
  }
  .brand-green { position: relative; z-index: 0; color: var(--ink); }
  .brand-green::after {
    content: ''; position: absolute; left: -3px; right: -3px; bottom: 3px;
    height: 9px; background: var(--lime); opacity: .75; z-index: -1; border-radius: 4px;
  }
  body.dark-mode .brand-green { color: var(--lime); }
  body.dark-mode .brand-green::after { display: none; }

  .nav-icon {
    position: relative; width: 40px; height: 40px; display: grid; place-items: center;
    border: 1.5px solid var(--line); border-radius: 50%;
    background: var(--surface); color: var(--ink); font-size: 1.05rem; transition: background .15s;
  }
  .nav-icon:hover { background: var(--soft); color: var(--ink); }
  .nav-icon.current { background: var(--forest); border-color: var(--forest); color: #fff; }
  .nav-badge {
    position: absolute; top: -5px; right: -5px; min-width: 18px; height: 18px; padding: 0 4px;
    display: grid; place-items: center; border-radius: 999px;
    background: var(--coral); color: var(--on-coral); font-size: .65rem; font-weight: 800;
  }
  .nav-badge.bump { animation: bump .3s ease; }

  /* ---------- Page ---------- */
  .page-wrap { max-width: 1040px; margin: auto; animation: fadeUp .4s ease both; }
  .back-link {
    display: inline-flex; align-items: center; gap: 8px; margin-bottom: 14px;
    color: var(--muted); font-size: .85rem; font-weight: 600;
  }
  .back-link:hover { color: var(--brand); }

  .page-head { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .page-head h1 { margin: 0; font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; }
  .count-chip {
    padding: 4px 12px; border-radius: 999px; background: rgba(198, 241, 53, .4); color: var(--forest);
    font-size: .76rem; font-weight: 700;
  }
  body.dark-mode .count-chip { background: rgba(198, 241, 53, .14); color: var(--lime); }

  /* ---------- ETA hero ---------- */
  .eta-hero {
    position: relative; overflow: hidden; display: flex; align-items: center; gap: 18px;
    margin-bottom: 22px; padding: 20px 24px; border-radius: 26px; color: #fff;
    background: linear-gradient(120deg, var(--hero-a), var(--hero-b));
  }
  .eta-hero::before {
    content: ''; position: absolute; right: -70px; top: -100px; width: 280px; height: 280px;
    border-radius: 50%; border: 2px dashed rgba(198, 241, 53, .35);
  }
  .eta-hero::after {
    content: ''; position: absolute; right: 50px; bottom: -130px; width: 220px; height: 220px;
    border-radius: 50%; background: rgba(198, 241, 53, .1);
  }
  .eta-ring { position: relative; z-index: 1; flex: 0 0 88px; width: 88px; height: 88px; }
  .eta-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .eta-ring .track { fill: none; stroke: rgba(255, 255, 255, .18); stroke-width: 6; }
  .eta-ring .bar {
    fill: none; stroke: var(--lime); stroke-width: 6; stroke-linecap: round;
    stroke-dasharray: 226.2; stroke-dashoffset: 0; transition: stroke-dashoffset 1s linear;
  }
  .eta-clock {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-family: 'Fredoka'; font-weight: 700; font-size: 1.3rem; color: var(--lime);
  }
  .eta-text { position: relative; z-index: 1; }
  .eta-text strong { display: block; margin-bottom: 2px; font-family: 'Fredoka'; font-size: 1.25rem; font-weight: 600; }
  .eta-text span { color: rgba(255, 255, 255, .75); font-size: .88rem; }

  /* ---------- Layout ---------- */
  .cart-grid { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 24px; align-items: start; }
  .cart-side { position: sticky; top: 92px; }

  .section-title { margin: 22px 0 12px; font-size: 1.15rem; font-weight: 600; }

  /* ---------- Item cards ---------- */
  .item-card {
    display: flex; gap: 14px; margin-bottom: 12px; padding: 14px; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line); border-radius: 22px;
    transition: opacity .28s ease, transform .28s ease, max-height .3s ease, margin .3s ease, padding .3s ease, border-color .15s;
  }
  .item-card:hover { border-color: var(--forest); }
  .item-card.enter { animation: fadeUp .35s ease both; }
  .item-card.removing {
    opacity: 0; transform: translateX(40px); margin-bottom: 0; padding-top: 0; padding-bottom: 0; border-width: 0;
  }
  .item-thumb {
    flex: 0 0 72px; width: 72px; height: 72px; display: grid; place-items: center;
    border-radius: 16px; background: var(--tile); font-size: 2rem;
  }
  .item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 8px; }
  .item-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; }
  .item-name { margin: 0 0 2px; font-size: .98rem; font-weight: 700; }
  .item-meta { margin: 0; color: var(--muted); font-size: .78rem; }
  .remove-btn {
    flex: 0 0 auto; width: 32px; height: 32px; display: grid; place-items: center;
    border: 0; border-radius: 50%; background: transparent; color: var(--coral); font-size: .95rem;
    transition: background .15s;
  }
  .remove-btn:hover { background: var(--soft); }
  .item-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .item-price { font-family: 'Fredoka'; font-size: 1.15rem; font-weight: 600; color: var(--brand); }
  .item-price .was { margin-left: 6px; font-family: 'Inter'; font-size: .78rem; font-weight: 400; color: var(--muted); text-decoration: line-through; }

  .stepper { display: flex; align-items: center; padding: 3px; border-radius: 999px; background: var(--forest); }
  .stepper button {
    width: 30px; height: 30px; display: grid; place-items: center;
    border: 0; border-radius: 50%; background: transparent; color: #fff; font-size: 1.1rem; line-height: 1;
  }
  .stepper button:hover { background: rgba(255, 255, 255, .16); }
  .stepper .qty { min-width: 26px; text-align: center; color: #fff; font-family: 'Fredoka'; font-weight: 600; font-size: .95rem; }
  .qty.bump { animation: bump .28s ease; }

  /* Empty state */
  .empty-state {
    display: none; text-align: center; padding: 40px 24px; margin-bottom: 12px;
    border: 2px dashed var(--line); border-radius: 22px; color: var(--muted);
    background: linear-gradient(160deg, rgba(198, 241, 53, .16), transparent 60%), var(--surface);
  }
  .empty-state.show { display: block; }
  .empty-state .emoji { display: inline-block; margin-bottom: 8px; font-size: 2.8rem; animation: floaty 4s ease-in-out infinite; }
  .empty-state h2 { margin-bottom: 6px; font-size: 1.2rem; color: var(--ink); }
  .empty-state p { max-width: 360px; margin: 0 auto; font-size: .88rem; }
  .btn-shop {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 16px; padding: 11px 22px; border-radius: 999px;
    background: var(--forest); color: #fff; font-size: .85rem; font-weight: 700; transition: background .15s, transform .15s;
  }
  .btn-shop:hover { background: var(--forest-2); color: #fff; transform: translateY(-2px); }

  /* Add-ons */
  .addon-scroll { display: flex; gap: 12px; overflow-x: auto; padding: 2px 2px 10px; }
  .addon-card {
    flex: 0 0 132px; padding: 10px; background: var(--surface);
    border: 1px solid var(--line); border-radius: 20px; transition: transform .2s, border-color .2s;
  }
  .addon-card:hover { transform: translateY(-3px); border-color: var(--forest); }
  .addon-thumb { display: grid; place-items: center; height: 62px; margin-bottom: 8px; border-radius: 14px; background: var(--tile); font-size: 1.7rem; }
  .addon-name { margin: 0 0 1px; font-size: .82rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .addon-price { margin: 0 0 8px; font-family: 'Fredoka'; font-size: .92rem; font-weight: 600; color: var(--brand); }
  .addon-add {
    width: 100%; padding: 6px 0; border: 1.5px solid var(--forest); border-radius: 999px;
    background: transparent; color: var(--brand); font-size: .76rem; font-weight: 800;
    transition: background .15s, color .15s;
  }
  body.dark-mode .addon-add { border-color: var(--lime); }
  .addon-add:hover { background: var(--forest); color: #fff; border-color: var(--forest); }
  .addon-add.added { background: var(--lime); color: var(--lime-ink); border-color: var(--lime); }

  /* ---------- Bill ---------- */
  .bill-card { padding: 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 26px; }
  .bill-card h2 { margin: 0 0 14px; font-size: 1.15rem; font-weight: 600; }
  .bill-row { display: flex; justify-content: space-between; margin-bottom: 9px; color: var(--muted); font-size: .88rem; }
  .bill-row.total {
    margin: 14px 0 0; padding-top: 14px; border-top: 1px dashed var(--line);
    color: var(--ink); font-size: 1.05rem; font-weight: 800;
  }
  .bill-row.total span:last-child { font-family: 'Fredoka'; font-size: 1.3rem; color: var(--brand); }
  .savings-chip {
    display: none; align-items: center; gap: 8px; margin: 4px 0 8px; padding: 9px 12px; border-radius: 14px;
    background: rgba(198, 241, 53, .4); color: var(--forest); font-size: .8rem; font-weight: 700;
  }
  .savings-chip.show { display: flex; }
  body.dark-mode .savings-chip { background: rgba(198, 241, 53, .14); color: var(--lime); }

  .btn-place-order {
    display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 52px; margin-top: 16px;
    border: 0; border-radius: 999px; background: var(--forest); color: #fff; font-size: .95rem; font-weight: 700;
    transition: background .15s, transform .12s;
  }
  .btn-place-order:hover { background: var(--forest-2); }
  .btn-place-order:active { transform: scale(.98); }
  .btn-place-order:disabled { opacity: .45; cursor: not-allowed; }
  .bill-note { display: flex; align-items: center; justify-content: center; gap: 6px; margin: 12px 0 0; color: var(--muted); font-size: .76rem; }
  .bill-note i { color: var(--brand); }

  /* Mobile checkout bar */
  .checkout-bar {
    display: none; position: fixed; left: 0; right: 0; bottom: 0; z-index: 1030;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -10px 24px -16px rgba(18, 53, 36, .4);
  }
  .checkout-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 560px; margin: auto; }
  .total-block strong { display: block; font-family: 'Fredoka'; font-size: 1.25rem; line-height: 1.1; color: var(--brand); }
  .total-block span { color: var(--muted); font-size: .75rem; }
  .checkout-inner .btn-place-order { width: auto; margin: 0; padding: 0 26px; }

  /* ---------- Delivery modal ---------- */
  .modal-backdrop { --bs-backdrop-bg: #07120c; }
  .modal-backdrop.show { --bs-backdrop-opacity: .6; }
  .modal-content {
    display: flex; flex-direction: column; max-height: calc(100vh - 3.5rem); overflow: hidden;
    border: 0; border-radius: 28px; background: var(--surface); color: var(--ink);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .65);
  }
  .em-head { position: relative; flex: 0 0 auto; padding: 24px 24px 20px; color: #fff; background: linear-gradient(120deg, var(--hero-a), var(--hero-b)); }
  .em-head::after {
    content: ''; position: absolute; right: -40px; top: -60px; width: 170px; height: 170px;
    border-radius: 50%; border: 2px dashed rgba(198, 241, 53, .35);
  }
  .em-head h5 { position: relative; z-index: 1; margin: 0 0 2px; font-size: 1.3rem; font-weight: 600; }
  .em-head p { position: relative; z-index: 1; margin: 0; color: rgba(255, 255, 255, .72); font-size: .82rem; }
  .em-close {
    position: absolute; right: 14px; top: 14px; z-index: 5; width: 34px; height: 34px; display: grid; place-items: center;
    border: 1px solid rgba(255, 255, 255, .3); border-radius: 50%; background: rgba(255, 255, 255, .14); color: #fff;
  }
  .em-grip { display: none; position: absolute; top: 8px; left: 50%; width: 44px; height: 5px; border-radius: 9px; background: rgba(255, 255, 255, .4); transform: translateX(-50%); }
  .em-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 20px 24px 8px; }

  .d-row {
    display: flex; align-items: flex-start; gap: 14px; margin-bottom: 12px; padding: 14px;
    border: 1px solid var(--line); border-radius: 18px; background: var(--surface);
  }
  .d-icon { flex: 0 0 40px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 12px; background: var(--tile); color: var(--brand); font-size: 1.05rem; }
  .d-main { flex: 1; min-width: 0; }
  .d-label { display: block; margin-bottom: 2px; color: var(--muted); font-size: .72rem; font-weight: 600; }
  .field-display { font-size: .92rem; font-weight: 600; line-height: 1.4; overflow-wrap: anywhere; }
  .field-input {
    width: 100%; padding: 8px 10px; border: 1.5px solid var(--forest); border-radius: 12px;
    background: var(--bg); color: var(--ink); font-family: 'Inter'; font-size: .92rem; resize: none;
  }
  .field-input:focus { outline: none; box-shadow: 0 0 0 3px rgba(198, 241, 53, .35); }
  .edit-pencil {
    flex: 0 0 34px; width: 34px; height: 34px; display: grid; place-items: center;
    border: 1.5px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); font-size: .85rem;
    transition: background .15s, color .15s, border-color .15s;
  }
  .edit-pencil:hover { background: var(--soft); }
  .edit-pencil.editing { background: var(--lime); border-color: var(--lime); color: var(--lime-ink); }
  #commentBox {
    width: 100%; padding: 9px 11px; border: 1.5px solid var(--line); border-radius: 12px;
    background: var(--bg); color: var(--ink); font-family: 'Inter'; font-size: .9rem; resize: none;
  }
  #commentBox:focus { outline: none; border-color: var(--forest); box-shadow: 0 0 0 3px rgba(198, 241, 53, .35); }

  .em-actions { flex: 0 0 auto; padding: 10px 24px calc(22px + env(safe-area-inset-bottom, 0px)); }
  .btn-confirm {
    display: flex; align-items: center; justify-content: space-between; gap: 10px; width: 100%; height: 52px; padding: 0 6px 0 22px;
    border: 0; border-radius: 999px; background: var(--lime); color: var(--lime-ink); font-size: .95rem; font-weight: 800;
    transition: transform .12s, box-shadow .2s;
  }
  .btn-confirm:hover { transform: translateY(-1px); box-shadow: 0 12px 22px -10px rgba(198, 241, 53, .9); }
  .btn-confirm b { padding: 10px 16px; border-radius: 999px; background: var(--forest); color: #fff; font-family: 'Fredoka'; font-size: .95rem; font-weight: 600; }

  /* Success */
  .success-view { text-align: center; padding: 26px 0 20px; }
  .success-check { display: flex; justify-content: center; margin-bottom: 12px; }
  .success-check-circle { fill: var(--lime); stroke: var(--lime-ink); stroke-width: 2; stroke-dasharray: 151; stroke-dashoffset: 151; animation: circleDraw .5s ease forwards; }
  .success-check-mark { stroke: var(--lime-ink); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 32; stroke-dashoffset: 32; animation: checkDraw .35s ease .45s forwards; }
  .success-view h3 { margin: 0 0 4px; font-size: 1.3rem; font-weight: 600; }
  .success-view p { margin: 0; color: var(--muted); font-size: .9rem; }

  /* Toast */
  .toast-message {
    position: fixed; left: 50%; z-index: 2000; bottom: calc(24px + env(safe-area-inset-bottom, 0px));
    max-width: calc(100vw - 32px); display: flex; align-items: center; gap: 9px; padding: 12px 20px; border-radius: 999px;
    background: var(--lime); color: var(--lime-ink); font-size: .85rem; font-weight: 700;
    box-shadow: 0 16px 28px -12px rgba(0, 0, 0, .5); opacity: 0; pointer-events: none; transform: translate(-50%, 30px);
    transition: opacity .25s, transform .25s;
  }
  .toast-message.show { opacity: 1; transform: translate(-50%, 0); }

  /* ---------- Responsive ---------- */
  @media (max-width: 991.98px) {
    body { padding-bottom: calc(92px + env(safe-area-inset-bottom, 0px)); }
    .cart-grid { grid-template-columns: 1fr; gap: 0; }
    .cart-side { position: static; }
    .bill-card .btn-place-order, .bill-note { display: none; }
    .checkout-bar { display: block; }
    .toast-message { bottom: calc(96px + env(safe-area-inset-bottom, 0px)); }
  }
  @media (max-width: 575.98px) {
    .navbar-brand { font-size: 1rem; }
    .eta-hero { padding: 16px 18px; gap: 14px; border-radius: 22px; }
    .eta-ring { flex-basis: 74px; width: 74px; height: 74px; }
    .eta-clock { font-size: 1.1rem; }
    .eta-text strong { font-size: 1.05rem; }
    .eta-text span { font-size: .8rem; }
    .item-thumb { flex-basis: 60px; width: 60px; height: 60px; font-size: 1.7rem; }

    .modal-dialog { margin: 0; max-width: none; min-height: 100%; align-items: flex-end; }
    .modal.fade .modal-dialog { transform: translateY(100%); transition: transform .38s cubic-bezier(.2, .9, .3, 1); }
    .modal.show .modal-dialog { transform: none; }
    .modal-content { width: 100%; max-height: 92vh; border-radius: 28px 28px 0 0; }
    .em-grip { display: block; }
    .em-head { padding-top: 28px; }
  }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
</style>
<link rel="stylesheet" href="scrollbar.css">
</head>
<body>

<!-- Navbar -->
<nav class="navbar sticky-top">
  <div class="container py-2">
    <div class="d-flex align-items-center w-100">
      <a href="index.html" class="navbar-brand fw-bold d-flex align-items-center gap-2">
        <span class="brand-icon"><i class="bi bi-leaf-fill"></i></span>
        <span>10 Min <span class="brand-green">Grocery</span></span>
      </a>
      <div class="ms-auto d-flex gap-2">
        <a href="cart.html" class="nav-icon current" title="Cart">
          <i class="bi bi-cart3"></i>
          <span class="nav-badge" id="navCartCount">0</span>
        </a>
        <button class="nav-icon" id="themeToggle" type="button" title="Toggle dark mode"><i class="bi bi-moon-stars"></i></button>
        <a href="profile.html" class="nav-icon" title="Profile"><i class="bi bi-person"></i></a>
      </div>
    </div>
  </div>
</nav>

<main class="container py-4">
  <div class="page-wrap">

    <a href="index.html" class="back-link"><i class="bi bi-arrow-left"></i> Continue shopping</a>

    <div class="page-head">
      <h1>Your cart</h1>
      <span class="count-chip" id="itemCountLabel">3 items</span>
    </div>

    <!-- ETA hero -->
    <section class="eta-hero">
      <div class="eta-ring">
        <svg viewBox="0 0 80 80"><circle class="track" cx="40" cy="40" r="36"/><circle class="bar" id="etaBar" cx="40" cy="40" r="36"/></svg>
        <div class="eta-clock" id="etaClock">10:00</div>
      </div>
      <div class="eta-text">
        <strong>Arriving soon</strong>
        <span>Order now to make the next delivery slot</span>
      </div>
    </section>

    <div class="cart-grid">

      <!-- Left: items + add-ons -->
      <div class="cart-main">
        <div id="cartItems"></div>

        <div class="empty-state" id="emptyState">
          <div class="emoji">🧺</div>
          <h2>Your basket is empty</h2>
          <p>Add a few things and we'll have them at your door in 10 minutes.</p>
          <a href="index.html" class="btn-shop">Start shopping <i class="bi bi-arrow-right"></i></a>
        </div>

        <h2 class="section-title">Forgot something?</h2>
        <div class="addon-scroll" id="addonList"></div>
      </div>

      <!-- Right: bill -->
      <aside class="cart-side">
        <div class="bill-card">
          <h2>Bill summary</h2>
          <div class="bill-row"><span>Item total</span><span id="billSubtotal">₹0</span></div>
          <div class="bill-row"><span>Delivery fee</span><span id="billDelivery">₹0</span></div>
          <div class="bill-row"><span>Handling charge</span><span id="billHandling">₹0</span></div>
          <div class="savings-chip" id="savingsChip"><i class="bi bi-stars"></i><span id="savingsText"></span></div>
          <div class="bill-row total"><span>To pay</span><span id="billTotal">₹0</span></div>

          <button class="btn-place-order" id="placeOrderDesktop" data-bs-toggle="modal" data-bs-target="#deliveryModal">
            Place order <i class="bi bi-arrow-right"></i>
          </button>
          <p class="bill-note"><i class="bi bi-lightning-charge-fill"></i> Delivered in about 10 minutes</p>
        </div>
      </aside>
    </div>

  </div>
</main>

<!-- Sticky checkout (phones / tablets) -->
<div class="checkout-bar" id="checkoutBar">
  <div class="checkout-inner">
    <div class="total-block">
      <strong id="stickyTotal">₹0</strong>
      <span>Total for <span id="stickyCount">0</span> items</span>
    </div>
    <button class="btn-place-order" id="placeOrderMobile" data-bs-toggle="modal" data-bs-target="#deliveryModal">
      Place order <i class="bi bi-arrow-right"></i>
    </button>
  </div>
</div>

<!-- Delivery details modal -->
<div class="modal fade" id="deliveryModal" tabindex="-1" aria-labelledby="deliveryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="em-head">
        <span class="em-grip"></span>
        <button type="button" class="em-close" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
        <h5 id="deliveryModalLabel">Confirm delivery details</h5>
        <p>Tap the pencil to change anything before you order.</p>
      </div>

      <div class="em-body">
        <div id="deliveryFormView">

          <div class="d-row">
            <div class="d-icon"><i class="bi bi-person"></i></div>
            <div class="d-main">
              <span class="d-label">Deliver to</span>
              <div class="field-display" id="nameDisplay">Aarav Mehta</div>
            </div>
          </div>

          <div class="d-row">
            <div class="d-icon"><i class="bi bi-geo-alt"></i></div>
            <div class="d-main">
              <span class="d-label">Address</span>
              <div class="field-display" id="addressDisplay"></div>
              <textarea class="field-input d-none" id="addressInput" rows="2"></textarea>
            </div>
            <button type="button" class="edit-pencil" id="addressBtn" onclick="toggleEdit('address')" aria-label="Edit address"><i class="bi bi-pencil"></i></button>
          </div>

          <div class="d-row">
            <div class="d-icon"><i class="bi bi-telephone"></i></div>
            <div class="d-main">
              <span class="d-label">Phone number</span>
              <div class="field-display" id="phoneDisplay"></div>
              <input class="field-input d-none" id="phoneInput" type="tel">
            </div>
            <button type="button" class="edit-pencil" id="phoneBtn" onclick="toggleEdit('phone')" aria-label="Edit phone number"><i class="bi bi-pencil"></i></button>
          </div>

          <div class="d-row">
            <div class="d-icon"><i class="bi bi-chat-left-text"></i></div>
            <div class="d-main">
              <span class="d-label">Note for delivery partner (optional)</span>
              <textarea id="commentBox" rows="2" placeholder="E.g. leave at the door, call on arrival..."></textarea>
            </div>
          </div>

        </div>

        <div id="orderSuccessView" class="success-view d-none">
          <div class="success-check">
            <svg viewBox="0 0 52 52" width="64" height="64">
              <circle class="success-check-circle" cx="26" cy="26" r="24" fill="none"/>
              <path class="success-check-mark" fill="none" d="M14 27l7 7 16-16"/>
            </svg>
          </div>
          <h3>Order placed!</h3>
          <p>Arriving in about 10 minutes</p>
        </div>
      </div>

      <div class="em-actions" id="modalFooterView">
        <button type="button" class="btn-confirm" onclick="confirmOrder()">
          <span>Confirm &amp; place order</span>
          <b id="modalTotal">₹0</b>
        </button>
      </div>

    </div>
  </div>
</div>

<div id="toast" class="toast-message"><i class="bi bi-check-circle-fill"></i><span>Added to cart</span></div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  const $ = (id) => document.getElementById(id);

  /* ---------- Dark mode (same key as every other page) ---------- */
  const themeToggle = $('themeToggle');
  let savedTheme = null;
  try { savedTheme = localStorage.getItem('grocery-theme'); } catch (e) {}
  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  if (savedTheme ? savedTheme === 'dark' : prefersDark) document.body.classList.add('dark-mode');

  function updateThemeIcon() {
    themeToggle.innerHTML = document.body.classList.contains('dark-mode')
      ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon-stars"></i>';
  }
  themeToggle.addEventListener('click', () => {
    document.body.classList.toggle('dark-mode');
    try { localStorage.setItem('grocery-theme', document.body.classList.contains('dark-mode') ? 'dark' : 'light'); } catch (e) {}
    updateThemeIcon();
  });
  updateThemeIcon();

  /* ---------- Config + data ---------- */
  const CURRENCY = '₹';          // change to '$' to match the homepage prices
  const DELIVERY_FEE = 15;
  const HANDLING = 6;
  const TOTAL_SECONDS = 600;
  const money = (n) => CURRENCY + n;

  const DEFAULT_ITEMS = [
    { id: 'tomato', name: 'Fresh tomatoes', meta: '500 g pack', price: 42, qty: 2, emoji: '🍅' },
    { id: 'milk', name: 'Toned milk', meta: '1 L carton', price: 58, qty: 1, emoji: '🥛' },
    { id: 'bread', name: 'Multigrain bread', meta: '400 g loaf', price: 120, was: 140, qty: 1, emoji: '🍞' }
  ];
  const ADDONS = [
    { id: 'eggs', name: 'Eggs (6)', meta: 'Pack of 6', price: 48, emoji: '🥚' },
    { id: 'banana', name: 'Bananas', meta: '6 pcs', price: 35, emoji: '🍌' },
    { id: 'coffee', name: 'Coffee 100g', meta: '100 g jar', price: 165, emoji: '☕' },
    { id: 'cheese', name: 'Cheese slices', meta: '200 g pack', price: 99, emoji: '🧀' }
  ];

  let cart = DEFAULT_ITEMS.map((i) => ({ ...i }));
  let fromReorder = false;
  try {
    const raw = localStorage.getItem('grocery-reorder');   // set by the Order history page
    if (raw) {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed) && parsed.length) { cart = parsed; fromReorder = true; }
      localStorage.removeItem('grocery-reorder');
    }
  } catch (e) {}

  /* ---------- Rendering ---------- */
  function itemCard(it, extraClass = '') {
    return `
      <div class="item-card ${extraClass}" data-id="${it.id}">
        <div class="item-thumb">${it.emoji}</div>
        <div class="item-info">
          <div class="item-top">
            <div>
              <p class="item-name">${it.name}</p>
              <p class="item-meta">${it.meta ? it.meta + ' · ' : ''}${money(it.price)} each</p>
            </div>
            <button class="remove-btn" data-remove aria-label="Remove ${it.name}"><i class="bi bi-trash3"></i></button>
          </div>
          <div class="item-row">
            <div class="item-price">${priceHtml(it)}</div>
            <div class="stepper">
              <button data-dec aria-label="Decrease quantity">−</button>
              <span class="qty">${it.qty}</span>
              <button data-inc aria-label="Increase quantity">+</button>
            </div>
          </div>
        </div>
      </div>`;
  }
  const priceHtml = (it) => `${money(it.price * it.qty)}${it.was ? `<span class="was">${money(it.was * it.qty)}</span>` : ''}`;

  function renderItems() { $('cartItems').innerHTML = cart.map((i) => itemCard(i)).join(''); }

  function renderAddons() {
    $('addonList').innerHTML = ADDONS.map((a) => `
      <div class="addon-card">
        <div class="addon-thumb">${a.emoji}</div>
        <p class="addon-name">${a.name}</p>
        <p class="addon-price">${money(a.price)}</p>
        <button class="addon-add" data-addon="${a.id}"><i class="bi bi-plus-lg"></i> Add</button>
      </div>`).join('');
  }

  function syncEmpty() {
    $('emptyState').classList.toggle('show', cart.length === 0);
  }

  function recalc() {
    let subtotal = 0, count = 0, savings = 0;
    cart.forEach((i) => {
      subtotal += i.price * i.qty;
      count += i.qty;
      if (i.was) savings += (i.was - i.price) * i.qty;
    });
    const has = count > 0;
    const total = subtotal + (has ? DELIVERY_FEE + HANDLING : 0);

    $('billSubtotal').textContent = money(subtotal);
    $('billDelivery').textContent = money(has ? DELIVERY_FEE : 0);
    $('billHandling').textContent = money(has ? HANDLING : 0);
    $('billTotal').textContent = money(total);
    $('stickyTotal').textContent = money(total);
    $('stickyCount').textContent = count;
    $('modalTotal').textContent = money(total);
    $('itemCountLabel').textContent = has ? `${count} item${count > 1 ? 's' : ''}` : 'Empty';

    $('savingsChip').classList.toggle('show', savings > 0);
    $('savingsText').textContent = `You're saving ${money(savings)} on this order`;

    $('placeOrderDesktop').disabled = !has;
    $('placeOrderMobile').disabled = !has;

    const badge = $('navCartCount');
    badge.textContent = count;
    badge.style.display = has ? 'grid' : 'none';
    badge.classList.remove('bump'); void badge.offsetWidth; badge.classList.add('bump');
  }

  /* ---------- Cart actions ---------- */
  const cardEl = (id) => $('cartItems').querySelector(`[data-id="${id}"]`);

  function updateCard(id) {
    const it = cart.find((i) => i.id === id), card = cardEl(id);
    if (!it || !card) return;
    const q = card.querySelector('.qty');
    q.textContent = it.qty;
    q.classList.remove('bump'); void q.offsetWidth; q.classList.add('bump');
    card.querySelector('.item-price').innerHTML = priceHtml(it);
  }

  function changeQty(id, delta) {
    const it = cart.find((i) => i.id === id);
    if (!it) return;
    if (it.qty + delta < 1) return removeItem(id);
    it.qty += delta;
    updateCard(id);
    recalc();
  }

  function removeItem(id) {
    const card = cardEl(id);
    cart = cart.filter((i) => i.id !== id);
    recalc();
    if (!card) return syncEmpty();
    card.style.maxHeight = card.offsetHeight + 'px';
    requestAnimationFrame(() => { card.classList.add('removing'); card.style.maxHeight = '0px'; });
    setTimeout(() => { card.remove(); syncEmpty(); }, 320);
  }

  function addAddon(id, btn) {
    const a = ADDONS.find((x) => x.id === id);
    const existing = cart.find((i) => i.id === id);
    if (existing) {
      existing.qty += 1;
      updateCard(id);
    } else {
      const item = { ...a, qty: 1 };
      cart.push(item);
      $('cartItems').insertAdjacentHTML('beforeend', itemCard(item, 'enter'));
    }
    syncEmpty();
    recalc();
    showToast(`${a.name} added to cart`);

    btn.classList.add('added');
    btn.innerHTML = '<i class="bi bi-check-lg"></i> Added';
    clearTimeout(btn._t);
    btn._t = setTimeout(() => { btn.classList.remove('added'); btn.innerHTML = '<i class="bi bi-plus-lg"></i> Add'; }, 1100);
  }

  $('cartItems').addEventListener('click', (e) => {
    const card = e.target.closest('.item-card');
    if (!card) return;
    const id = card.dataset.id;
    if (e.target.closest('[data-inc]')) changeQty(id, 1);
    else if (e.target.closest('[data-dec]')) changeQty(id, -1);
    else if (e.target.closest('[data-remove]')) removeItem(id);
  });

  $('addonList').addEventListener('click', (e) => {
    const btn = e.target.closest('[data-addon]');
    if (btn) addAddon(btn.dataset.addon, btn);
  });

  function showToast(message) {
    const toast = $('toast');
    toast.querySelector('span').textContent = message;
    toast.classList.add('show');
    clearTimeout(window.toastTimer);
    window.toastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
  }

  /* ---------- Countdown ring ---------- */
  const RING = 2 * Math.PI * 36;
  const etaBar = $('etaBar'), etaClock = $('etaClock');
  let secondsLeft = TOTAL_SECONDS;
  function tick() {
    const m = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
    const s = String(secondsLeft % 60).padStart(2, '0');
    etaClock.textContent = `${m}:${s}`;
    etaBar.style.strokeDashoffset = RING * (1 - secondsLeft / TOTAL_SECONDS);
  }
  tick();
  setInterval(() => { if (secondsLeft > 0) { secondsLeft--; tick(); } }, 1000);

  /* ---------- Delivery details (prefilled from the profile page when available) ---------- */
  let profile = {};
  try { profile = JSON.parse(localStorage.getItem('grocery-profile')) || {}; } catch (e) {}
  $('nameDisplay').textContent = profile.name || 'Aarav Mehta';
  $('addressDisplay').textContent = $('addressInput').value = '204, Lakeview Apartments, 5th Cross, Singanallur, Coimbatore – 641005';
  $('phoneDisplay').textContent = $('phoneInput').value = profile.phone || '+91 98765 43210';

  function isEditing(field) { return !$(field + 'Input').classList.contains('d-none'); }

  function toggleEdit(field) {
    if (isEditing(field)) return commitEdit(field);
    $(field + 'Display').classList.add('d-none');
    const input = $(field + 'Input');
    input.classList.remove('d-none');
    input.focus();
    input.select();
    const btn = $(field + 'Btn');
    btn.classList.add('editing');
    btn.innerHTML = '<i class="bi bi-check-lg"></i>';
    btn.setAttribute('aria-label', 'Save ' + field);
  }

  function commitEdit(field) {
    if (!isEditing(field)) return;
    const display = $(field + 'Display'), input = $(field + 'Input'), btn = $(field + 'Btn');
    const value = input.value.trim();
    if (value) display.textContent = value; else input.value = display.textContent;
    input.classList.add('d-none');
    display.classList.remove('d-none');
    btn.classList.remove('editing');
    btn.innerHTML = '<i class="bi bi-pencil"></i>';
    btn.setAttribute('aria-label', 'Edit ' + field);
  }

  ['address', 'phone'].forEach((field) => {
    $(field + 'Input').addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); commitEdit(field); }
    });
  });

  function confirmOrder() {
    commitEdit('address');
    commitEdit('phone');
    $('deliveryFormView').classList.add('d-none');
    $('modalFooterView').classList.add('d-none');
    $('orderSuccessView').classList.remove('d-none');
    setTimeout(() => bootstrap.Modal.getOrCreateInstance($('deliveryModal')).hide(), 1900);
  }

  $('deliveryModal').addEventListener('hidden.bs.modal', () => {
    $('orderSuccessView').classList.add('d-none');
    $('deliveryFormView').classList.remove('d-none');
    $('modalFooterView').classList.remove('d-none');
  });

  /* ---------- Init ---------- */
  renderItems();
  renderAddons();
  syncEmpty();
  recalc();
  if (fromReorder) showToast('Items from your past order are in the cart');
</script>

</body>
</html>